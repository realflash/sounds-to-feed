# syntax=docker/dockerfile:1
#
# Container smoke test for the standard base image pattern used by Sounds to Feed.
# Built on the same shared rolling standard base as the production image, hardened
# in place, and used to prove get_iplayer + its Perl toolchain run after hardening.

# Stage 1: dependency stage on the shared rolling standard base (has shell + apt).
FROM registry.digitalocean.com/attono/attono-base:latest AS deps

# Pin get_iplayer to a real upstream release tag (not master) for reproducibility.
ARG GETIPLAYER_VERSION=v3.36

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        perl \
        libxml-simple-perl \
        liblwp-protocol-https-perl \
        libmojolicious-perl \
        libcgi-pm-perl \
        ffmpeg \
        atomicparsley \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://raw.githubusercontent.com/get-iplayer/get_iplayer/${GETIPLAYER_VERSION}/get_iplayer" \
        -o /usr/local/bin/get_iplayer && \
    chmod +x /usr/local/bin/get_iplayer

# Stage 2: final image IS the deps stage, hardened in place. JSON-array
# ENTRYPOINT only (no shell survives attono-harden).
FROM deps
RUN /usr/local/bin/attono-harden

ENTRYPOINT ["/usr/bin/perl", "/usr/local/bin/get_iplayer", "--version"]
